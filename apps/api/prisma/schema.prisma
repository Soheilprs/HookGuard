generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A Uniswap v4 hook contract observed on a supported chain.
model Hook {
  id              String    @id @default(cuid())
  address         String
  chainId         Int
  creator         String
  deploymentBlock BigInt
  verifiedSource  Boolean   @default(false)
  riskScore       Int?
  createdAt       DateTime  @default(now())
  firstSeenBlock  BigInt
  lastSeenBlock   BigInt
  poolCount       Int       @default(0)
  lastIndexedAt   DateTime?

  findings Finding[]
  pools    Pool[]

  @@unique([address, chainId])
  @@index([chainId])
  @@index([riskScore])
  @@index([lastIndexedAt])
  @@map("hooks")
}

/// A Uniswap v4 pool that references a hook.
model Pool {
  id             String  @id @default(cuid())
  poolId         String
  chainId        Int
  hookAddress    String
  token0         String
  token1         String
  fee            Int
  tickSpacing    Int
  createdBlock   BigInt
  token0Address  String
  token1Address  String
  token0Symbol   String?
  token1Symbol   String?
  createdAtBlock BigInt
  currencyPair   String

  hook Hook @relation(fields: [hookAddress, chainId], references: [address, chainId], onDelete: Restrict)

  @@unique([poolId, chainId])
  @@index([hookAddress, chainId])
  @@map("pools")
}

/// Raw contract artifact for a hook or related address.
model Contract {
  id                    String    @id @default(cuid())
  address               String
  chainId               Int
  bytecode              String    @db.Text
  sourceCode            String?   @db.Text
  compilerVersion       String?
  bytecodeHash          String
  sourceVerified        Boolean   @default(false)
  sourceUrl             String?
  abiJson               String?   @db.Text
  isProxy               Boolean   @default(false)
  implementationAddress String?
  adminAddress          String?
  lastCheckedAt         DateTime?

  functions    ContractFunction[]
  permissions  ContractPermission[]

  @@unique([address, chainId])
  @@index([chainId])
  @@map("contracts")
}

/// ABI-visible or bytecode-observed function of a contract.
model ContractFunction {
  id              String @id @default(cuid())
  contractId      String
  name            String
  selector        String
  visibility      String
  stateMutability String

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, selector])
  @@index([contractId])
  @@map("contract_functions")
}

/// Observed permission fact (owner, admin, role). Not a risk judgment.
model ContractPermission {
  id         String @id @default(cuid())
  contractId String
  type       String
  address    String
  source     String

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("contract_permissions")
}

/// An evidence-based security observation. Never stored without evidence JSON.
model Finding {
  id          String   @id @default(cuid())
  hookId      String
  ruleId      String
  title       String
  category    String
  severity    String
  description String   @db.Text
  evidence    Json
  createdAt   DateTime @default(now())

  hook Hook @relation(fields: [hookId], references: [id], onDelete: Cascade)

  @@unique([hookId, ruleId])
  @@index([hookId])
  @@index([severity])
  @@index([ruleId])
  @@map("findings")
}

/// Resume cursor for a (chain, contract) log scan.
model IndexerCheckpoint {
  id                 String   @id @default(cuid())
  chainId            Int
  contractAddress    String
  lastProcessedBlock BigInt
  updatedAt          DateTime @updatedAt

  @@unique([chainId, contractAddress])
  @@index([chainId])
  @@map("indexer_checkpoints")
}
