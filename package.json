{
  "name": "hookguard",
  "version": "0.0.1",
  "private": true,
  "description": "Open-source security intelligence platform for Uniswap v4 hooks",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev -w @hookguard/api",
    "dev:web": "npm run dev -w @hookguard/web",
    "build": "npm run build -w @hookguard/types && npm run build -w @hookguard/config && npm run build -w @hookguard/blockchain && npm run build -w @hookguard/api && npm run build -w @hookguard/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm run db:generate -w @hookguard/api",
    "db:validate": "npm run db:validate -w @hookguard/api",
    "index:v4": "npm run index:v4 -w @hookguard/api --",
    "inspect:contracts": "npm run inspect:contracts -w @hookguard/api --",
    "analyze:hooks": "npm run analyze:hooks -w @hookguard/api --",
    "monitor:hooks": "npm run monitor:hooks -w @hookguard/api --",
    "alerts:retry": "npm run alerts:retry -w @hookguard/api --",
    "validate:apply": "npm run validate:apply -w @hookguard/api --",
    "report:risk": "npm run report:risk -w @hookguard/api --",
    "clean": "rm -rf apps/*/.next apps/*/dist packages/*/dist coverage"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
