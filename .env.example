# Copy to .env and fill in values. Never commit secrets.

# --- API ---
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hookguard

# RPC endpoints (read-only, no API keys in git)
RPC_URL_ETHEREUM=https://ethereum-rpc.publicnode.com
RPC_URL_UNICHAIN=https://mainnet.unichain.org

# Indexer (optional)
# INDEX_CHAIN=ethereum
# INDEX_BATCH_SIZE=2000
# INDEX_FROM_BLOCK=
# INDEX_START_BLOCK_ETHEREUM=21689047
# INDEX_START_BLOCK_UNICHAIN=1
# INDEX_MAX_BLOCKS=
# INDEX_CONFIRMATIONS=0

# Optional verified-source lookup (never required; bytecode intelligence still runs)
# ETHERSCAN_API_KEY=
# UNISCAN_API_KEY=

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
