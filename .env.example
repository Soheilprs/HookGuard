# Copy to .env and fill in values. Never commit secrets.
# See docs/DEPLOYMENT.md for production notes.

# --- API ---
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001

# PostgreSQL
# docker compose publishes Postgres on host port 5434 (container 5432).
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/hookguard

# RPC endpoints (read-only). Public URLs are for local development only.
# Production indexing of historical Initialize logs needs archive-capable RPC.
RPC_URL_ETHEREUM=https://ethereum-rpc.publicnode.com
RPC_URL_UNICHAIN=https://mainnet.unichain.org

# Indexer (optional)
# INDEX_CHAIN=ethereum
# INDEX_BATCH_SIZE=2000
# INDEX_FROM_BLOCK=
# INDEX_START_BLOCK_ETHEREUM=21689047
# INDEX_START_BLOCK_UNICHAIN=1
# INDEX_MAX_BLOCKS=
# INDEX_CONFIRMATIONS=0

# Optional verified-source lookup (bytecode intelligence still runs without these)
# ETHERSCAN_API_KEY=
# UNISCAN_API_KEY=

# Optional Telegram alerts (leave empty to store deliveries as PENDING)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:3001
# Client-side RainbowKit only. The API never receives this value.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
